[Unit]
Description=asset-hub pack workers
After=network-online.target asset-hub-api.service
Wants=network-online.target

[Service]
Type=simple
User=ybyc
Group=asset-hub
Environment=ASSET_HUB_CONFIG=/etc/asset-hub/config.yaml
Environment=ASSET_HUB_ROOT=/opt/asset-hub
WorkingDirectory=/opt/asset-hub
ExecStart=/opt/asset-hub/.venv/bin/asset-hub-worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=300
KillMode=mixed
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
