[Unit]
Description=asset-hub catalog / SKU index rebuild
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
User=ybyc
Group=asset-hub
Environment=ASSET_HUB_CONFIG=/etc/asset-hub/config.yaml
Environment=ASSET_HUB_ROOT=/opt/asset-hub
WorkingDirectory=/opt/asset-hub
ExecStart=/opt/asset-hub/.venv/bin/asset-hub-index
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
