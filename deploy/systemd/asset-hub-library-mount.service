[Unit]
Description=asset-hub library disk mount guard
After=local-fs.target
Before=asset-hub-worker.service asset-hub-sync.service asset-hub-index.service

[Service]
Type=oneshot
ExecStart=/opt/asset-hub/deploy/ensure-library-mount.sh
RemainAfterExit=yes
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
